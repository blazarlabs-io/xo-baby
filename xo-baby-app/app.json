{
  "expo": {
    "name": "xo-baby-app",
    "slug": "xo-baby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "jsEngine": "jsc",
    "scheme": [
      "xo-baby-app",
      "com.googleusercontent.apps.278376901127-7q9p5vicj0sicgg8fg91a0kuv8s5n1vr"
    ],
    "developmentClient": {
      "silentLaunch": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.midnight.medicalrecords"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.xobaby.android",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "xo-baby-app",
              "path": "/oauth2redirect/google"
            },
            {
              "scheme": "com.googleusercontent.apps.278376901127-7q9p5vicj0sicgg8fg91a0kuv8s5n1vr",
              "path": "/oauth2redirect/google"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "f929cd25-b511-4f2e-9eff-9c1aa29b3567"
      },
      "googleWebClientId": "278376901127-8mgjhm39opqjdpiqrs7imb64vuj1qqpc.apps.googleusercontent.com",
      "googleAndroidClientId": "278376901127-7q9p5vicj0sicgg8fg91a0kuv8s5n1vr.apps.googleusercontent.com",
      "apiUrl": "https://xo-baby.blazarlabs.io"
    },
    "owner": "daikifujii"
  }
}
